# API (all optional, defaults shown)
NODE_ENV=development
HOST=localhost
PORT=3333
MONGO_URI=mongodb://localhost:27017/restaurant
LOG_LEVEL=info
# Allowed browser origin for CORS (the web dev server proxies /api, so usually unneeded)
# CORS_ORIGIN=http://localhost:4200
# Delay between automatic order status steps in ms; 0 disables the simulator
SIMULATOR_STEP_MS=8000
EVENT_BUFFER_SIZE=500
# Seed a demo menu on startup when the database has no categories
SEED_ON_EMPTY=true
SEED_ITEM_COUNT=3000
