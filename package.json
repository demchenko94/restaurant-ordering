    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/web": "23.2.0",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
