{
  "name": "restaurant-ordering",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm run db:up && nx run-many -t serve -p api web --parallel=2",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "check": "nx run-many -t lint test build && nx format:check",
    "seed": "nx build api && node dist/apps/api/main.js --seed"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
